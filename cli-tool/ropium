# Timeout command
def cmd_timeout(args):
    global search_timeout

    if not args:
        print(timeout_help)
        return

    subcommand = args[0]
    if subcommand == "set":
        if len(args) < 2:
            raise ContextException("Missing timeout value (in seconds)")
        try:
            value = float(args[1])
        except ValueError:
            raise ContextException(f"'{args[1]}' is not a valid number of seconds")
        if not math.isfinite(value) or value <= 0:
            raise ContextException("The timeout must be a positive number of seconds")
        search_timeout = value
        extra_args = args[2:]
    elif subcommand == "reset":
        search_timeout = None
        extra_args = args[1:]
    else:
        raise ContextException(f"Unsupported action '{subcommand}'")

    if extra_args:
        warning(f"Extra arguments ignored: '{' '.join(extra_args)}'", skip=True)

# Maxtries command
def cmd_maxtries(args):
    global max_tries

    if not args:
        print(maxtries_help)
        return

    subcommand = args[0]
    if subcommand == "set":
        if len(args) < 2:
            raise ContextException("Missing number of tries")
        try:
            value = int(args[1])
        except ValueError:
            raise ContextException(f"'{args[1]}' is not a valid number of tries")
        if value < 1:
            raise ContextException("The number of tries must be at least 1")
        max_tries = value
        extra_args = args[2:]
    elif subcommand == "reset":
        max_tries = DEFAULT_MAX_TRIES
        extra_args = args[1:]
    else:
        raise ContextException(f"Unsupported action '{subcommand}'")

    if extra_args:
        warning(f"Extra arguments ignored: '{' '.join(extra_args)}'", skip=True)

